{
  "name": "orinstone-discord-bot",
  "version": "2.0.0",
  "description": "Bot Discord Orinstone - Tickets, modération, niveaux, AutoMod, statut des services, panel web et commandes fun",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start server.js --name orinstone-bot",
    "pm2:stop": "pm2 stop orinstone-bot",
    "pm2:restart": "pm2 restart orinstone-bot",
    "pm2:logs": "pm2 logs orinstone-bot"
  },
  "keywords": [
    "discord",
    "bot",
    "tickets",
    "moderation",
    "levels",
    "automod",
    "panel",
    "orinstone"
  ],
  "author": "Orinstone",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}